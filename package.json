{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.ts",
    "mcp": "node --experimental-strip-types mcp/server.ts",
    "atlas:browser": "playwright install chromium",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "db:init": "node --experimental-strip-types scripts/seed.ts",
    "db:reset": "rm -f data/atlas.db && node --experimental-strip-types scripts/seed.ts",
    "lint": "tsc --noEmit",
    "debug:providers": "node --experimental-strip-types scripts/debug-providers.ts",
    "debug:openrouter:models": "node --experimental-strip-types scripts/debug-openrouter.ts",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "next": "^15.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  }
}
